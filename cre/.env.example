# Copy to cre/.env. Never commit it.

# CRE needs a signing key present even for a read-and-call workflow that does not send transactions.
# Use a throwaway testnet key with no funds, NOT the relayer's, agent's or deployer's key. 64 hex characters, no 0x.
CRE_ETH_PRIVATE_KEY=

# The Monad testnet RPC the simulator reads from. The public one is enough.
CRE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Must equal CRE_TOKEN on the agent (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
CRE_TOKEN_ENV=
