# THUNAI — environment
#
# Copy to `.env` and fill in. Every service reads from this one file.
#
#   cp .env.example .env
#
# Only four values are strictly required to run the whole thing on Monad testnet:
#   MONAD_RPC_URL, DEPLOYER_PRIVATE_KEY, RELAYER_PRIVATE_KEY, AGENT_PRIVATE_KEY
# Everything else has a working default or degrades honestly (see the notes).
#
# NEVER commit the filled-in .env. It is already in .gitignore.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Chain  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# Monad testnet, chain id 10143.
# The public endpoint works; a QuickNode/Alchemy URL is better for the demo because
# `eth_sendRawTransactionSync` (instant receipts) is not on every provider. The app
# shows honestly which path it got, so a provider without it costs latency, not truth.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional. Where event counting reads logs from, if MONAD_RPC_URL limits eth_getLogs to a small range
# (a Quicknode Discover plan allows only 5 blocks). The public RPC allows 100.
LOGS_RPC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Keys  (REQUIRED — three separate accounts, all funded with testnet MON)
# ─────────────────────────────────────────────────────────────────────────────
# Get MON from https://faucet.monad.xyz
#
# These are three DIFFERENT keys on purpose. None of them can move family money:
# the contract requires the student's signature to spend and the guardian's passkey
# to release anything held. Losing any of these costs gas, not savings.

# Deploys the contracts and owns them (can set roles and the Agora flag).
DEPLOYER_PRIVATE_KEY=0x

# Sponsors gas for every user action. Holds no spending power.
# Also holds the CTK float that stands in for the licensed remittance partner.
RELAYER_PRIVATE_KEY=0x

# The keeper. Only ever calls runAllowance and expireHold, both of which any
# stranger is allowed to call, so this key carries no authority at all.
AGENT_PRIVATE_KEY=0x

# The addresses of the two keys above. Leave blank to default to the deployer.
# Fill these in before deploying if the relayer and agent are separate accounts.
RELAYER_ADDRESS=
AGENT_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Deployed contracts  (filled in automatically by the deploy script)
# ─────────────────────────────────────────────────────────────────────────────
# `pnpm contracts:deploy` writes contracts/deployments/10143.json, and every service
# reads that file. Set these only to point at an existing deployment.

THUNAI_VAULT_ADDRESS=
SCAM_SIGNALS_ADDRESS=

# Which deployment file to use. Blank = contracts/deployments/10143.json (the stand-in vault the demos use).
# `agora` = 10143.agora.json, the vault built on the real Agora CTK and AUSD. One setting switches the vault,
# ScamSignals, both tokens and the Agora flag together. Switch only after Agora has whitelisted that vault
# (`pnpm agora:check`), then run `pnpm agora:enable`, set THUNAI_START_BLOCK to that vault's deploy block
# (70125617), and restart `pnpm dev`.
THUNAI_DEPLOYMENT=

# ─────────────────────────────────────────────────────────────────────────────
# 4. Agora Instant Settlement  (optional — off by default, and disclosed when off)
# ─────────────────────────────────────────────────────────────────────────────
# The CTK/AUSD pair on Monad testnet. The swap is gated by an APPROVED_SWAPPER role,
# so the vault address must be whitelisted by the Agora team before this can be on.
#
# With AGORA_ENABLED=false the vault credits AUSD from a seeded float instead, the
# app's Details screen says "Agora: off (disclosed fallback)", and the indexer counts
# Agora vs fallback settlements separately. Nothing silently pretends.

AGORA_PAIR_ADDRESS=0x1Aa8958Aa34cEC8096EF4381cb335effe977b0ae
AGORA_ENABLED=false

# Real Agora testnet token addresses. Leave BLANK and the deploy script creates
# clearly-labelled stand-ins ("Thunai Stand-In CTK (testnet)") so no screenshot can
# imply these are real dollars.
CTK_ADDRESS=
AUSD_ADDRESS=

# AUSD float minted to the vault so credited allowances are always backed.
# 6 decimals: 1000000000 = $1,000. Only used with stand-in tokens.
SEED_AUSD_FLOAT=1000000000

# ─────────────────────────────────────────────────────────────────────────────
# 5. The classifier  (optional — falls back to deterministic rules)
# ─────────────────────────────────────────────────────────────────────────────
# Names the scam script and writes the Tamil/English explanation on the alert.
# It NEVER moves or releases money: the hold is already open, on contract rules,
# before this runs. With no key set, a keyword-and-context classifier takes over and
# the app labels the source, so the demo works offline and costs nothing.

ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5
# low | medium | high — low keeps a one-shot label fast
CLASSIFIER_EFFORT=low
CLASSIFIER_TIMEOUT_MS=12000

# ─────────────────────────────────────────────────────────────────────────────
# 6. Paging the guardian  (optional — WhatsApp link always works without it)
# ─────────────────────────────────────────────────────────────────────────────
# Web Push needs a VAPID pair. Generate one with:
#   npx web-push generate-vapid-keys
# Without these, the agent still builds the alert and the pre-filled WhatsApp deep
# link, which is the backstop a parent in Chennai will actually see.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@thunai.app

# ─────────────────────────────────────────────────────────────────────────────
# 7. Service wiring  (defaults are correct for local development)
# ─────────────────────────────────────────────────────────────────────────────

PORT=8787                            # relayer
AGENT_PORT=8788
AGENT_URL=http://localhost:8788
RELAYER_URL=http://localhost:8787
APP_URL=http://localhost:8081        # used for the deep link in a notification
CORS_ORIGIN=*                        # lock this down before any public deploy
DATA_DIR=./.data
LOG_LEVEL=info
KEEPER_INTERVAL_MS=60000
KEEPER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# 7b. Access control  (the relayer and agent are reachable from the internet)
# ─────────────────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# NEVER put any of these in an EXPO_PUBLIC_ variable: it would ship to every device.

# Gates the dev endpoints: /fund (spends the relayer's stand-in float), and on the agent
# /keeper/tick and /classify. Leave BLANK and those endpoints do not exist.
DEV_ADMIN_TOKEN=

# Shared by the relayer and the agent. Their webhooks (/hold-opened, /sos, ...) and the
# relayer's push-subscription list answer only a caller that holds it. `pnpm dev` makes one for
# the run if this is blank; set it when you run the services separately.
INTERNAL_TOKEN=

# Testnet only. Lets a guardian's own signature deposit stand-in money for her family (the
# "Send money now" button), playing the part of the licensed remittance partner. Leave
# false anywhere real money could be involved.
TESTNET_PARTNER_STANDIN=false
PARTNER_MAX_USD=1000

# ─────────────────────────────────────────────────────────────────────────────
# 8. The app  (EXPO_PUBLIC_* values are inlined into the client bundle)
# NOTE: the one-site build (`pnpm web:build`) ignores the two server addresses below and uses /relayer and /agent on
# its own origin. They only matter for the standalone Expo dev server (`pnpm dev`). APP_URL (section 7) should be
# https://<your-host>/app when you use the one-site setup.
# ─────────────────────────────────────────────────────────────────────────────
# Never put a secret in an EXPO_PUBLIC_ variable: it ships to every device.
#
# For a demo on two real phones, these must be addresses the phones can reach —
# your machine's LAN IP or a tunnel, not localhost.

EXPO_PUBLIC_RELAYER_URL=http://localhost:8787
EXPO_PUBLIC_AGENT_URL=http://localhost:8788
EXPO_PUBLIC_INDEXER_URL=http://localhost:8080/v1/graphql

# The WebAuthn relying party. Passkeys are scoped to this host and will not work from
# anywhere else, which is what stops a phishing page collecting a guardian's approval.
# Leave BLANK on web and the app uses the hostname it was served from, so localhost
# and a deployed URL both work with no rebuild.
EXPO_PUBLIC_RP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 9. Indexer  (not deployed in this submission — the app reads the contract and relayer directly)
# ─────────────────────────────────────────────────────────────────────────────
# Envio needs Linux, macOS or WSL 2. On Windows, `pnpm check:indexer` validates the
# config, schema and handlers against the contracts without running it.
#
# Set the start block to the vault's deployment block to skip empty history.

THUNAI_START_BLOCK=0
ENVIO_API_TOKEN=
